// prisma/schema.prisma
// Portal da Turma — Fisioterapia UNIP
// Ver spec/07-portal-spec.md (pasta base do projeto) para o racional do modelo.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────

/// Conta de acesso ao portal.
/// `ativo` é o portão: toda conta nasce inativa e só entra depois que o ADMIN libera.
model User {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senha        String    @db.VarChar(255) // hash bcrypt — nunca texto puro
  role         Role      @default(ALUNO)
  ativo        Boolean   @default(false)
  ultimoAcesso DateTime?

  materiasCriadas  Materia[]  @relation("MateriaCriadaPor")
  trabalhosCriados Trabalho[] @relation("TrabalhoCriadoPor")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([role])
  @@index([ativo])
  @@map("usuarios")
}

/// Tentativas de login, para travar força bruta por e-mail e por IP.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  sucesso   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────────────────────
// MATÉRIAS
// ─────────────────────────────────────────

model Materia {
  id        String    @id @default(cuid())
  nome      String
  professor String?
  diaSemana DiaSemana @default(A_DEFINIR)
  anotacoes String?   @db.Text
  cor       CorTema   @default(AZUL)
  arquivada Boolean   @default(false)

  criadoPorId String
  criadoPor   User       @relation("MateriaCriadaPor", fields: [criadoPorId], references: [id])
  trabalhos   Trabalho[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoPorId])
  @@index([arquivada])
  @@index([diaSemana])
  @@map("materias")
}

// ─────────────────────────────────────────
// TRABALHOS / EVENTOS / AVISOS
// ─────────────────────────────────────────

/// O que alimenta o mural da tela inicial.
model Trabalho {
  id        String    @id @default(cuid())
  titulo    String
  descricao String?   @db.Text
  tipo      TipoPost  @default(TRABALHO)
  entregaEm DateTime?
  publicado Boolean   @default(true)

  materiaId   String
  materia     Materia @relation(fields: [materiaId], references: [id])
  criadoPorId String
  criadoPor   User    @relation("TrabalhoCriadoPor", fields: [criadoPorId], references: [id])
  anexos      Anexo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([materiaId])
  @@index([criadoPorId])
  @@index([entregaEm])
  @@index([publicado, criadoEm])
  @@map("trabalhos")
}

/// Arquivo anexado a um trabalho: foto do quadro, PDF de slides, documento.
/// `publicId` é o identificador no Cloudinary — sem ele não há como apagar o
/// arquivo remoto quando o trabalho é excluído.
model Anexo {
  id       String    @id @default(cuid())
  nome     String // nome original enviado pelo usuário
  url      String    @db.VarChar(500)
  publicId String    @db.VarChar(255)
  tipo     TipoAnexo
  tamanho  Int // bytes

  trabalhoId String
  trabalho   Trabalho @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([trabalhoId])
  @@map("anexos")
}

// ─────────────────────────────────────────
// VOCABULÁRIOS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  ALUNO
}

enum TipoPost {
  TRABALHO
  EVENTO
  AVISO
}

enum TipoAnexo {
  IMAGEM
  PDF
  DOCUMENTO
  APRESENTACAO
  OUTRO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
  A_DEFINIR
}

enum CorTema {
  AZUL
  VERDE
  VERMELHO
  ROXO
  LARANJA
}
