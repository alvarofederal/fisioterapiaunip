// prisma/schema.prisma
// Portal da Turma — Fisioterapia UNIP
// Ver spec/07-portal-spec.md (pasta base do projeto) para o racional do modelo.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────

/// Conta de acesso ao portal.
/// `ativo` é o portão: toda conta nasce inativa e só entra depois que o ADMIN libera.
model User {
  id    String @id @default(cuid())
  nome  String
  email String @unique

  /// Registro Acadêmico (número de matrícula). É por ele que o ADMIN reconhece
  /// quem é quem na hora de liberar o acesso — nome e e-mail podem ser
  /// qualquer coisa, o RA não.
  ra String @unique @db.VarChar(30)

  senha        String    @db.VarChar(255) // hash bcrypt — nunca texto puro
  role         Role      @default(ALUNO)
  ativo        Boolean   @default(false)
  ultimoAcesso DateTime?

  materiasCriadas  Materia[]  @relation("MateriaCriadaPor")
  estudos          Estudo[]    @relation("EstudoDoUsuario")
  aulasProprias    Aula[]      @relation("AulaDoAluno")
  atividadesCriadas Atividade[] @relation("AtividadeCriadaPor")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([role])
  @@index([ativo])
  @@map("usuarios")
}

/// Tentativas de login, para travar força bruta por e-mail e por IP.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  sucesso   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────────────────────
// MATÉRIAS
// ─────────────────────────────────────────

model Materia {
  id        String    @id @default(cuid())
  nome      String
  professor String?
  diaSemana DiaSemana @default(A_DEFINIR)
  anotacoes String?   @db.Text
  cor       CorTema   @default(AZUL)
  arquivada Boolean   @default(false)

  /// Ano e período em que a matéria é cursada.
  /// O semestre do curso (1 a 10) NÃO é guardado — é derivado por
  /// `semestreDoCurso()` em src/lib/dominio.ts. Guardar o derivado junto seria
  /// abrir espaço para os dois discordarem.
  ano     Int @default(2026)
  periodo Int @default(2) // 1 ou 2

  /// Presencial tem encontro com data marcada; EaD o aluno faz no ritmo dele.
  modalidade Modalidade @default(EAD)

  criadoPorId String
  criadoPor   User        @relation("MateriaCriadaPor", fields: [criadoPorId], references: [id])
  atividades  Atividade[]
  aulas       Aula[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoPorId])
  @@index([arquivada])
  @@index([diaSemana])
  @@index([ano, periodo])
  @@map("materias")
}

// ─────────────────────────────────────────
// TRABALHOS / EVENTOS / AVISOS
// ─────────────────────────────────────────

/// Atividade acadêmica: o que a turma precisa fazer ou comparecer.
///
/// Os quatro tipos moram na mesma tabela com campos anuláveis, e cada
/// formulário mostra só o que faz sentido para aquele tipo. Quatro tabelas
/// quase iguais dariam quatro consultas para montar uma lista única — e a
/// lista única é justamente o ponto da tela inicial.
model Atividade {
  id        String        @id @default(cuid())
  titulo    String
  descricao String?       @db.Text
  tipo      TipoAtividade @default(TRABALHO_EXTRA_CLASSE)

  /// Prazo de entrega — usado por TRABALHO_EXTRA_CLASSE.
  entregaEm DateTime?

  /// Quando acontece — usado por EVENTO, SEMINARIO e CONGRESSO.
  /// `dataFim` só faz sentido em CONGRESSO, que dura mais de um dia.
  dataInicio DateTime?
  dataFim    DateTime?
  horaInicio String?   @db.VarChar(5)
  horaFim    String?   @db.VarChar(5)

  /// Onde acontece: sala, auditório, endereço ou plataforma.
  local String?

  /// Inscrição, sala virtual ou local de entrega online.
  linkExterno String? @db.VarChar(500)

  /// Horas de certificado — CONGRESSO e alguns EVENTOS.
  cargaHoraria Int?

  /// Quem apresenta junto — trabalho em grupo e SEMINARIO.
  integrantes String? @db.Text

  /// Arquivada sai do mural mas continua consultável.
  /// Só o ADMIN arquiva, desarquiva e exclui — o aluno apenas lê.
  arquivada   Boolean   @default(false)
  arquivadaEm DateTime?

  /// Matéria é opcional de propósito: congresso e evento externo costumam não
  /// pertencer a nenhuma.
  materiaId   String?
  materia     Materia? @relation(fields: [materiaId], references: [id])
  criadoPorId String
  criadoPor   User     @relation("AtividadeCriadaPor", fields: [criadoPorId], references: [id])
  anexos      Anexo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([materiaId])
  @@index([criadoPorId])
  @@index([tipo])
  @@index([entregaEm])
  @@index([dataInicio])
  @@index([arquivada, criadoEm])
  @@map("atividades")
}

/// Arquivo anexado a um trabalho: foto do quadro, PDF de slides, documento.
/// `publicId` é o identificador no Cloudinary — sem ele não há como apagar o
/// arquivo remoto quando o trabalho é excluído.
model Anexo {
  id       String    @id @default(cuid())
  nome     String // nome original enviado pelo usuário
  url      String    @db.VarChar(500)
  publicId String    @db.VarChar(255)
  tipo     TipoAnexo
  tamanho  Int // bytes

  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([atividadeId])
  @@map("anexos")
}

// ─────────────────────────────────────────
// VOCABULÁRIOS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  ALUNO
}

enum TipoAtividade {
  TRABALHO_EXTRA_CLASSE
  EVENTO
  SEMINARIO
  CONGRESSO
}

/// Presencial tem data marcada e vale para a turma toda.
/// EaD cada aluno organiza no próprio ritmo — por isso o encontro EaD tem dono.
enum Modalidade {
  PRESENCIAL
  EAD
}

enum TipoAnexo {
  IMAGEM
  PDF
  DOCUMENTO
  APRESENTACAO
  OUTRO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
  A_DEFINIR
}

enum CorTema {
  AZUL
  VERDE
  VERMELHO
  ROXO
  LARANJA
}

// ─────────────────────────────────────────
// CRONOGRAMA E ESTUDO
// ─────────────────────────────────────────

/// Um encontro do cronograma: a data em que a matéria acontece.
/// Conteúdo e horário são combinados pela turma — só o ADMIN edita.
model Aula {
  id         String   @id @default(cuid())
  data       DateTime @db.Date
  horaInicio String?  @db.VarChar(5) // "08:00"
  horaFim    String?  @db.VarChar(5) // "10:50"

  /// O que será visto nesse encontro.
  conteudo String? @db.Text

  modalidade Modalidade @default(PRESENCIAL)

  /// Dono do encontro — o campo que separa as duas agendas.
  ///
  /// NULO      = cronograma PRESENCIAL da turma. Só o ADMIN edita, todo mundo vê.
  /// PREENCHIDO = sessão de estudo EaD daquele aluno. Só ele vê, só ele edita.
  ///
  /// Sem isso, o EaD de um colega apareceria na agenda dos outros — e cada um
  /// estuda EaD no próprio ritmo.
  donoId String?
  dono   User?   @relation("AulaDoAluno", fields: [donoId], references: [id], onDelete: Cascade)

  materiaId String
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  estudos   Estudo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([materiaId, data])
  @@index([data])
  @@index([donoId, data])
  @@index([modalidade, data])
  @@map("aulas")
}

/// O acompanhamento de estudo de UMA pessoa sobre UM encontro.
/// É individual de propósito: a anotação de revisão de cada um é sua, mesmo
/// que o cronograma seja o mesmo para a turma inteira.
model Estudo {
  id         String       @id @default(cuid())
  status     StatusEstudo @default(A_ESTUDAR)
  anotacoes  String?      @db.Text
  revisadoEm DateTime?

  aulaId    String
  aula      Aula   @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   User   @relation("EstudoDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([aulaId, usuarioId])
  @@index([usuarioId, status])
  @@map("estudos")
}

enum StatusEstudo {
  A_ESTUDAR
  ESTUDANDO
  REVISADO
}
