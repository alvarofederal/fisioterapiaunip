// prisma/schema.prisma
// Portal da Turma — Fisioterapia UNIP
// Ver spec/07-portal-spec.md (pasta base do projeto) para o racional do modelo.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────

/// Conta de acesso ao portal.
/// `ativo` é o portão: toda conta nasce inativa e só entra depois que o ADMIN libera.
model User {
  id    String @id @default(cuid())
  nome  String
  email String @unique

  /// Registro Acadêmico (número de matrícula). É por ele que o ADMIN reconhece
  /// quem é quem na hora de liberar o acesso — nome e e-mail podem ser
  /// qualquer coisa, o RA não.
  ra String @unique @db.VarChar(30)

  senha        String    @db.VarChar(255) // hash bcrypt — nunca texto puro
  role         Role      @default(ALUNO)
  ativo        Boolean   @default(false)
  ultimoAcesso DateTime?

  materiasCriadas     Materia[]            @relation("MateriaCriadaPor")
  progressosUnidade   ProgressoUnidade[]   @relation("ProgressoDoUsuario")
  estudosTeleaula     EstudoTeleaula[]     @relation("EstudoTeleaulaDoUsuario")
  progressosAtividade ProgressoAtividade[] @relation("ProgressoAtividadeDoUsuario")
  unidadesProprias    Unidade[]            @relation("UnidadeDoAluno")
  estudos             Estudo[]             @relation("EstudoDoUsuario")
  aulasProprias       Aula[]               @relation("AulaDoAluno")
  atividadesCriadas   Atividade[]          @relation("AtividadeCriadaPor")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([role])
  @@index([ativo])
  @@map("usuarios")
}

/// Tentativas de login, para travar força bruta por e-mail e por IP.
model LoginAttempt {
  id       String   @id @default(cuid())
  email    String
  ip       String?
  sucesso  Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────────────────────
// MATÉRIAS
// ─────────────────────────────────────────

model Materia {
  id        String    @id @default(cuid())
  nome      String
  professor String?
  diaSemana DiaSemana @default(A_DEFINIR)
  anotacoes String?   @db.Text
  cor       CorTema   @default(AZUL)
  arquivada Boolean   @default(false)

  /// Em que semestre a matéria é cursada.
  /// Ano e período moram no Semestre, não aqui: guardados nos dois lugares, um
  /// dia discordariam. O semestre do curso (1 a 10) continua derivado por
  /// `semestreDoCurso()` em src/lib/dominio.ts, pelo mesmo motivo.
  semestreId String
  semestre   Semestre @relation(fields: [semestreId], references: [id])

  /// Presencial tem encontro com data marcada; EaD o aluno faz no ritmo dele.
  modalidade Modalidade @default(EAD)

  criadoPorId String
  criadoPor   User        @relation("MateriaCriadaPor", fields: [criadoPorId], references: [id])
  atividades  Atividade[]
  aulas       Aula[]
  unidades    Unidade[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoPorId])
  @@index([arquivada])
  @@index([diaSemana])
  @@index([semestreId])
  @@map("materias")
}

// ─────────────────────────────────────────
// TRABALHOS / EVENTOS / AVISOS
// ─────────────────────────────────────────

/// Atividade acadêmica: o que a turma precisa fazer ou comparecer.
///
/// Os quatro tipos moram na mesma tabela com campos anuláveis, e cada
/// formulário mostra só o que faz sentido para aquele tipo. Quatro tabelas
/// quase iguais dariam quatro consultas para montar uma lista única — e a
/// lista única é justamente o ponto da tela inicial.
model Atividade {
  id        String        @id @default(cuid())
  titulo    String
  descricao String?       @db.Text
  tipo      TipoAtividade @default(TRABALHO_EXTRA_CLASSE)

  /// Prazo de entrega — usado por TRABALHO_EXTRA_CLASSE.
  entregaEm DateTime?

  /// Quando acontece — usado por EVENTO, SEMINARIO e CONGRESSO.
  /// `dataFim` só faz sentido em CONGRESSO, que dura mais de um dia.
  dataInicio DateTime?
  dataFim    DateTime?
  horaInicio String?   @db.VarChar(5)
  horaFim    String?   @db.VarChar(5)

  /// Onde acontece: sala, auditório, endereço ou plataforma.
  local String?

  /// Inscrição, sala virtual ou local de entrega online.
  linkExterno String? @db.VarChar(500)

  /// Horas de certificado — CONGRESSO e alguns EVENTOS.
  cargaHoraria Int?

  /// Quem apresenta junto — trabalho em grupo e SEMINARIO.
  integrantes String? @db.Text

  /// Arquivada sai do mural mas continua consultável.
  /// Só o ADMIN arquiva, desarquiva e exclui — o aluno apenas lê.
  arquivada   Boolean   @default(false)
  arquivadaEm DateTime?

  /// Matéria é opcional de propósito: congresso e evento externo costumam não
  /// pertencer a nenhuma.
  materiaId   String?
  materia     Materia?             @relation(fields: [materiaId], references: [id])
  criadoPorId String
  criadoPor   User                 @relation("AtividadeCriadaPor", fields: [criadoPorId], references: [id])
  anexos      Anexo[]
  progressos  ProgressoAtividade[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([materiaId])
  @@index([criadoPorId])
  @@index([tipo])
  @@index([entregaEm])
  @@index([dataInicio])
  @@index([arquivada, criadoEm])
  @@map("atividades")
}

/// Arquivo anexado a um trabalho: foto do quadro, PDF de slides, documento.
/// `publicId` é o identificador no Cloudinary — sem ele não há como apagar o
/// arquivo remoto quando o trabalho é excluído.
model Anexo {
  id       String    @id @default(cuid())
  nome     String // nome original enviado pelo usuário
  url      String    @db.VarChar(500)
  publicId String    @db.VarChar(255)
  tipo     TipoAnexo
  tamanho  Int // bytes

  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([atividadeId])
  @@map("anexos")
}

// ─────────────────────────────────────────
// VOCABULÁRIOS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  ALUNO
}

enum TipoAtividade {
  TRABALHO_EXTRA_CLASSE
  EVENTO
  SEMINARIO
  CONGRESSO
}

/// Presencial tem data marcada e vale para a turma toda.
/// EaD cada aluno organiza no próprio ritmo — por isso o encontro EaD tem dono.
enum Modalidade {
  PRESENCIAL
  EAD
}

enum TipoAnexo {
  IMAGEM
  PDF
  DOCUMENTO
  APRESENTACAO
  OUTRO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
  A_DEFINIR
}

enum CorTema {
  AZUL
  VERDE
  VERMELHO
  ROXO
  LARANJA
}

// ─────────────────────────────────────────
// CRONOGRAMA E ESTUDO
// ─────────────────────────────────────────

/// Um encontro do cronograma: a data em que a matéria acontece.
/// Conteúdo e horário são combinados pela turma — só o ADMIN edita.
model Aula {
  id         String   @id @default(cuid())
  data       DateTime @db.Date
  horaInicio String?  @db.VarChar(5) // "08:00"
  horaFim    String?  @db.VarChar(5) // "10:50"

  /// O que será visto nesse encontro.
  conteudo String? @db.Text

  modalidade Modalidade @default(PRESENCIAL)

  /// Dono do encontro — o campo que separa as duas agendas.
  ///
  /// NULO      = cronograma PRESENCIAL da turma. Só o ADMIN edita, todo mundo vê.
  /// PREENCHIDO = sessão de estudo EaD daquele aluno. Só ele vê, só ele edita.
  ///
  /// Sem isso, o EaD de um colega apareceria na agenda dos outros — e cada um
  /// estuda EaD no próprio ritmo.
  donoId String?
  dono   User?   @relation("AulaDoAluno", fields: [donoId], references: [id], onDelete: Cascade)

  materiaId String
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  estudos   Estudo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([materiaId, data])
  @@index([data])
  @@index([donoId, data])
  @@index([modalidade, data])
  @@map("aulas")
}

/// O acompanhamento de estudo de UMA pessoa sobre UM encontro.
/// É individual de propósito: a anotação de revisão de cada um é sua, mesmo
/// que o cronograma seja o mesmo para a turma inteira.
model Estudo {
  id         String       @id @default(cuid())
  status     StatusEstudo @default(A_ESTUDAR)
  anotacoes  String?      @db.Text
  revisadoEm DateTime?

  aulaId    String
  aula      Aula   @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   User   @relation("EstudoDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([aulaId, usuarioId])
  @@index([usuarioId, status])
  @@map("estudos")
}

enum StatusEstudo {
  A_ESTUDAR
  ESTUDANDO
  REVISADO
}

// ─────────────────────────────────────────
// SEMESTRE
// ─────────────────────────────────────────

/// O semestre letivo em que a turma está.
///
/// Não guarda qual é o "atual": isso é derivado do par (ano, período) mais
/// recente, em `semestreAtual()`. Uma coluna `atual` permitiria dois semestres
/// marcados ao mesmo tempo, e aí não haveria resposta certa para a pergunta.
model Semestre {
  id      String @id @default(cuid())
  ano     Int
  periodo Int // 1 ou 2

  /// Só informativo, para a tela mostrar o intervalo. Nada depende disso.
  inicioEm DateTime? @db.Date
  fimEm    DateTime? @db.Date

  materias Materia[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([ano, periodo])
  @@map("semestres")
}

// ─────────────────────────────────────────
// AVA — UNIDADES, TELEAULAS E PROGRESSO
// ─────────────────────────────────────────

/// Uma unidade do AVA: "Unidade I", com seu livro-texto, seus slides e suas
/// teleaulas.
///
/// É currículo, não agenda: não tem data. Quem cadastra é o ADMIN, porque a
/// estrutura vem da UNIP e vale igual para a turma inteira. O que é de cada
/// aluno são o `ProgressoUnidade` e as anotações das teleaulas.
model Unidade {
  id     String  @id @default(cuid())
  numero Int // 1, 2, 3... exibido como I, II, III
  titulo String?

  /// Dono da unidade — o campo que separa o currículo da turma do estudo
  /// particular de cada um.
  ///
  /// NULO      = unidade da turma. Só o ADMIN cria e edita; todo mundo vê e
  ///             escreve o próprio resumo dentro dela.
  /// PREENCHIDO = unidade daquele aluno. Só ele vê, só ele edita — nem o
  ///             ADMIN, porque é organização de estudo pessoal.
  ///
  /// As teleaulas não têm dono próprio: herdam o da unidade em que estão.
  /// Dois pontos de propriedade permitiriam uma teleaula privada dentro de
  /// uma unidade da turma, e não haveria resposta certa para quem pode
  /// apagá-la.
  donoId String?
  dono   User?   @relation("UnidadeDoAluno", fields: [donoId], references: [id], onDelete: Cascade)

  materiaId String
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  teleaulas  Teleaula[]
  progressos ProgressoUnidade[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// A unicidade é por dono: a Unidade I da turma e a Unidade I de um aluno
  /// são coisas diferentes e convivem na mesma matéria.
  @@unique([materiaId, donoId, numero])
  @@index([materiaId])
  @@index([donoId])
  @@map("unidades")
}

/// Uma teleaula dentro da unidade — normalmente quatro por unidade.
///
/// Diferente de `Aula`, que é encontro com data marcada. Esta não tem data:
/// ela se ordena por número e o aluno assiste quando quiser.
model Teleaula {
  id     String  @id @default(cuid())
  numero Int
  titulo String?

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  estudos EstudoTeleaula[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeId, numero])
  @@index([unidadeId])
  @@map("teleaulas")
}

/// O que ESTE aluno já cumpriu nesta unidade.
///
/// As quatro colunas são a forma fixa do AVA da UNIP: toda unidade tem
/// livro-texto, slides, Atividade Teleaula e Questionário. Os rótulos e a
/// ordem de exibição ficam em `ITENS_DA_UNIDADE` (src/lib/dominio.ts) — a tela
/// nunca cita coluna na mão.
model ProgressoUnidade {
  id String @id @default(cuid())

  livroLido         Boolean @default(false)
  slidesVistos      Boolean @default(false)
  atividadeFeita    Boolean @default(false)
  questionarioFeito Boolean @default(false)

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   User    @relation("ProgressoDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeId, usuarioId])
  @@index([usuarioId])
  @@map("progressos_unidade")
}

/// O estudo de ESTE aluno nesta teleaula: o status e o resumo que ele escreveu.
///
/// `anotacoes` é o texto que vai para o PDF de revisão da matéria — é a razão
/// de ser da tela, não um campo acessório.
model EstudoTeleaula {
  id        String       @id @default(cuid())
  status    StatusEstudo @default(A_ESTUDAR)
  /// MediumText, nao Text: o resumo e HTML de editor rico e Text para em
  /// 64 KB. As imagens entram como URL do Cloudinary, entao o que cresce e a
  /// formatacao — tabela e legenda ocupam espaco sem o aluno escrever mais.
  anotacoes String?      @db.MediumText

  teleaulaId String
  teleaula   Teleaula @relation(fields: [teleaulaId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    User     @relation("EstudoTeleaulaDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([teleaulaId, usuarioId])
  @@index([usuarioId, status])
  @@map("estudos_teleaula")
}

/// O que ESTE aluno já cumpriu neste trabalho.
///
/// Carimbo e correção são do trabalho presencial: o aluno leva a folha, o
/// professor carimba na entrega e devolve corrigida mais tarde. São estados da
/// folha de cada um — a turma inteira não é carimbada junto —, por isso ficam
/// por aluno, do mesmo jeito que `Estudo` e `ProgressoUnidade`.
///
/// Os rótulos e a ordem ficam em `MARCOS_DO_TRABALHO` (src/lib/dominio.ts).
model ProgressoAtividade {
  id        String  @id @default(cuid())
  carimbado Boolean @default(false)
  corrigido Boolean @default(false)

  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     User      @relation("ProgressoAtividadeDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([atividadeId, usuarioId])
  @@index([usuarioId])
  @@map("progressos_atividade")
}

// ─────────────────────────────────────────
// CONFIGURACAO DO PORTAL
// ─────────────────────────────────────────

/// Chaves que o ADMIN liga e desliga para a turma.
///
/// Tabela de chave/valor, e nao uma coluna por opcao: opcao nova vira uma
/// linha em CHAVES_DE_CONFIGURACAO (src/lib/configuracoes.ts), sem migracao.
/// Linha ausente significa o padrao declarado la — por isso a tabela pode
/// nascer vazia e o portal funcionar.
model Configuracao {
  chave String  @id @db.VarChar(60)
  ativo Boolean

  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}
